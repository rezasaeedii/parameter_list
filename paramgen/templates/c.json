{
	// Place your snippets for c here. Each snippet is defined under a snippet name and has a prefix, body and 
	// description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
	// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the 
	// same ids are connected.
	// Example:
	// "Print to console": {
	// 	"prefix": "log",
	// 	"body": [
	// 		"console.log('$1');",
	// 		"$2"
	// 	],
	// 	"description": "Log output to console"
	// }

	"Create new header file": {
		"prefix": "h-file",
		"body": [
			"/**",
			"  ******************************************************************************",
			"  * @file    $TM_FILENAME",
			"  * @brief   ",
			"  ******************************************************************************",
			"  * @attention",
			"  *",
			"  * Copyright (c) $CURRENT_YEAR FAS.",
			"  * All rights reserved.",
			"  *",
			"  * This software is licensed under terms that can be found in the LICENSE file",
			"  * in the root directory of this software component.",
			"  * If no LICENSE file comes with this software, it is provided AS-IS.",
			"  *",
			"  ******************************************************************************",
			"  */",
			"",
			"/* Define to prevent recursive inclusion -------------------------------------*/",
			"#ifndef ${TM_FILENAME_BASE/(.*)/${1:/upcase}/}_H",
			"#define ${TM_FILENAME_BASE/(.*)/${1:/upcase}/}_H",
			"",
			"#ifdef __cplusplus",
			"extern \"C\" {",
			"#endif",
			"",
			"/* Includes ----------------------------------------------------------------- */",
			"/* Exported defines --------------------------------------------------------- */",
			"/* Exported macros ---------------------------------------------------------- */",
			"/* Exported types ----------------------------------------------------------- */",
			"/* Exported functions ------------------------------------------------------- */",
			"/* Exported variables ------------------------------------------------------- */",
			"",
			"#ifdef __cplusplus",
			"}",
			"#endif",
			"",
			"#endif /* ${TM_FILENAME_BASE/(.*)/${1:/upcase}/}_H */",
			"",
			"/* === Copyright (c) $CURRENT_YEAR FAS === EOF === */",
			"",
		],
		"description": "Creates a new C header file."
	},

	"Create new source file": {
		"prefix": "c-file",
		"body": [
			"/**",
			"  ******************************************************************************",
			"  * @file    $TM_FILENAME",
			"  * @brief   ",
			"  ******************************************************************************",
			"  * @attention",
			"  *",
			"  * Copyright (c) $CURRENT_YEAR FAS.",
			"  * All rights reserved.",
			"  *",
			"  * This software is licensed under terms that can be found in the LICENSE file",
			"  * in the root directory of this software component.",
			"  * If no LICENSE file comes with this software, it is provided AS-IS.",
			"  *",
			"  ******************************************************************************",
			"  @verbatim",
			"",
			"  @endverbatim",
			"  */",
			"",
			"/* Includes ----------------------------------------------------------------- */",
			"#include \"$TM_FILENAME_BASE.h\"",
			"",
			"/* Private defines ---------------------------------------------------------- */",
			"/* Private macros ----------------------------------------------------------- */",
			"/* Private types ------------------------------------------------------------ */",
			"/* Private variables -------------------------------------------------------- */",
			"/* Private functions -------------------------------------------------------- */",
			"/* Exported variables ------------------------------------------------------- */",
			"",
			"/*",
			"  ==============================================================================",
			"                        ##### Exported Functions #####",
			"  ==============================================================================",
			"*/",
			"",
			"/*",
			"  ==============================================================================",
			"                        ##### Private Functions #####",
			"  ==============================================================================",
			"*/",
			"",
			"/* === Copyright (c) $CURRENT_YEAR FAS === EOF === */",
			"",
		],
		"description": "Creates a new C source file."
	},

	"Create init/Enable block": {
		"prefix": "ie-block",
		"body": [
			"me->_init = false;",
			"me->Enable = false;\r\n",
			"$1\r\n",
			"me->_init = true;",
			"me->Enable = true;",
		],
		"description": "Creates an init/enable block."
	},
}